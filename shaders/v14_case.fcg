// V13 build / approved V14 case fragment shader (Cg -> RSX FPO)
uniform sampler2D coverTex : TEXUNIT0;
uniform float4 baseColor;
uniform float useTexture;
uniform float alpha;

float4 main(float2 uv : TEXCOORD0, float3 normal : TEXCOORD1) : COLOR
{
    float3 n = normalize(normal);
    float3 lightDir = normalize(float3(-0.35, 0.55, 0.75));
    float light = 0.72 + 0.28 * max(0.0, dot(n, lightDir));
    float4 c = (useTexture > 0.5) ? tex2D(coverTex, uv) : baseColor;
    c.rgb *= light;
    c.a *= alpha;
    return c;
}
